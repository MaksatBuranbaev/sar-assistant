# Скопируйте в .env и заполните. Файл .env в git не попадает (см. .gitignore).

# --- PostgreSQL ---------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DB=pss_db

# Роль ТОЛЬКО НА ЧТЕНИЕ. Создаётся скриптом sql/readonly_role.sql.
# Подключаться суперпользователем нельзя: права в БД — основной механизм
# защиты от SQL, который сгенерировала модель.
PG_USER=pss_readonly
PG_PASSWORD=change_me_in_env

# Запрос, идущий дольше этого времени, снимается сервером.
PG_STATEMENT_TIMEOUT_MS=8000
PG_CONNECT_TIMEOUT_S=5

# --- Только для docker compose -----------------------------------------
# Пароль роли pss_readonly внутри стенда. Одно значение задаёт его и в БД,
# и в приложении. Отдельная переменная, а не PG_PASSWORD: последний в этом
# файле означает пароль вашего локального postgres, и переиспользовать его
# внутри compose нельзя — значения разъедутся.
PSS_READONLY_PASSWORD=change_me_in_env
# Пароль суперпользователя стенда; порт наружу не публикуется.
POSTGRES_SUPERUSER_PASSWORD=postgres

# --- GigaChat -----------------------------------------------------------
GIGACHAT_CREDENTIALS=your_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT_S=60
GIGACHAT_MAX_RETRIES=3

# Сертификаты GigaChat подписаны «Russian Trusted Root CA», которого нет в
# системном хранилище. Правильный путь — скачать его и указать здесь:
#   GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
#   GIGACHAT_VERIFY_SSL=true
# Значение false отключает проверку сертификата и допустимо только локально:
# соединение становится уязвимым к перехвату.
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=false

# --- Поведение ассистента ----------------------------------------------
MAX_ROWS=500              # предел строк, навешиваемый валидатором на запрос
MAX_ROWS_TO_LLM=50        # сколько строк уходит модели на пересказ
MAX_SQL_ATTEMPTS=3        # попыток сгенерировать SQL с учётом self-correction
FEW_SHOT_K=4              # похожих примеров в промпте
HISTORY_TURNS=3           # ходов диалога, передаваемых модели
LOG_LEVEL=INFO
